# MiniCoder 配置模板。复制为 .env 并填写（或直接设置同名环境变量）。
# 注意：.env 应加入 .gitignore，不要提交 API Key。

# DeepSeek API Key（必填，除非使用 --mock）
DEEPSEEK_API_KEY=

# 模型名（DeepSeek OpenAI 兼容端点）
MINICODER_MODEL=deepseek-chat

# OpenAI 兼容 Base URL
MINICODER_BASE_URL=https://api.deepseek.com

# 最大迭代轮数
MINICODER_MAX_ITERATIONS=15
